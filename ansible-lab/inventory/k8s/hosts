# Kubernetes cluster nodes (on-prem Ubuntu)
#
# Master: 192.168.34.240 (Semaphore UI host)
# Worker: 192.168.34.236
# Do not put the control-plane host in [k8s_workers].

[k8s_control_plane]
k8s-master ansible_host=192.168.34.240 ansible_user=sgorrela

[k8s_workers]
k8s-worker1 ansible_host=192.168.34.236 ansible_user=sgorrela

[k8s_cluster:children]
k8s_control_plane
k8s_workers

[k8s_cluster:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_connection=ssh
ansible_become=true
ansible_become_user=root
